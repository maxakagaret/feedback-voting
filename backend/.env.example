APP_NAME="Feedback Voting"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8083

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Docker Compose defaults (see ../docker-compose.yml)
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=feedback
DB_USERNAME=feedback
DB_PASSWORD=secret

SESSION_DRIVER=file
CACHE_STORE=redis
QUEUE_CONNECTION=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
